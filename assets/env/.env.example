# RemoveIt Mobile App - Environment Template
# Duplicate this file to .env.dev, .env.staging, or .env.prod

APP_TITLE=RemoveIt (Dev)
API_BASE_URL=http://127.0.0.1:8000/api/v1
ENABLE_LOGGING=true
ENABLE_ADMOB=false

# Google Mobile Ads Unit IDs (Google Official Test IDs)
ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712

# RevenueCat In-App Purchases Public API Keys
REVENUECAT_ANDROID_KEY=goog_sample_key_android
REVENUECAT_IOS_KEY=appl_sample_key_ios

# Google OAuth 2.0 Web Client ID
GOOGLE_SERVER_CLIENT_ID=
